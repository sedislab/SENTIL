// Tandem queueing network as a CTMC.

const int C = 20;
const real LAMBDA = 4.8;
const real MU1 = 5.0;
const real MU2 = 5.0;
const real TIME_BOUND = 50.0;

int(0..C) q1 = 0;
int(0..C) q2 = 0;

property P_Overflow = Pmax(<>[T<=TIME_BOUND] (q1 == C || q2 == C));

process Tandem()
{
   alt {
   :: when(q1 < C)           rate(LAMBDA) {= q1 = q1 + 1 =}
   :: when(q1 > 0 && q2 < C) rate(MU1)    {= q1 = q1 - 1, q2 = q2 + 1 =}
   :: when(q2 > 0)           rate(MU2)    {= q2 = q2 - 1 =}
   };
   Tandem()
}

Tandem()