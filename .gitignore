# Rust build output (Cargo.lock is committed for reproducible builds)
target/
*.rs.bk
*.pdb

# proptest writes a seed file per crate when it finds a failing case. The cases worth
# keeping are promoted into named tests, so the seeds themselves are scratch.
proptest-regressions/

# Lean proof build output (lake-manifest.json is committed)
.lake/

# Python: bytecode, virtualenvs, packaging metadata, test cache. Built wheels land
# under target/ and are already covered above.
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Editor and OS noise
.idea/
.vscode/
*.swp
*~
.DS_Store

# LaTeX tutorial build byproducts. The PDF is compiled and released by CI.
tutorial/sentil-tutorial.pdf
tutorial/*.aux
tutorial/*.log
tutorial/*.out
tutorial/*.toc
tutorial/*.fls
tutorial/*.fdb_latexmk
tutorial/*.synctex.gz

# Benchmark figures are generated under benchmarks/results and staged into the
# tutorial at build time, so they are not committed a second time here.
tutorial/figures/smc_*.png
tutorial/figures/rare_event*.png