// Grammar for SENTIL temporal-logic formulas.
// First pass at the parser, before deciding how to handle error positions.
use crate::formula::ast::{Formula, Interval, Predicate};

grammar;

pub Spec: Formula = {
    <l:Spec> "implies" <r:Or> => Formula::Implies(Box::new(l), Box::new(r)),
    Or,
};

Or: Formula = {
    <l:Or> "or" <r:And> => Formula::Or(Box::new(l), Box::new(r)),
    And,
};

And: Formula = {
    <l:And> "and" <r:Unary> => Formula::And(Box::new(l), Box::new(r)),
    Unary,
};

Unary: Formula = {
    "not" <f:Unary> => Formula::Not(Box::new(f)),
    "always" <i:Interval> "(" <f:Spec> ")" => Formula::Always(i, Box::new(f)),
    "eventually" <i:Interval> "(" <f:Spec> ")" => Formula::Eventually(i, Box::new(f)),
    Primary,
};

Primary: Formula = {
    "(" <Spec> ")",
    <p:Predicate> => Formula::Predicate(p),
};

// Predicate, Interval, and the arithmetic terms still need rules, plus the
// past-time and probabilistic operators.