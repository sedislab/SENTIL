# Maintainer: Paapa Kwesi Quansah <paapa_quansah1@baylor.edu>

# Binary package for the prebuilt SENTIL C library and the sentil CLI. The core
# is Rust, built once and attached to the GitHub release, so this package unpacks
# the release archives rather than compiling. The two sha256 entries are filled by
# the release-pacman workflow from the published assets; a checked-in PKGBUILD
# carries the named placeholder tokens so it is never published with a stale hash.

pkgname=sentil
pkgver=1.0.0
pkgrel=1
pkgdesc="Runtime verification for Signal Temporal Logic and its probabilistic extension PrSTL, with a C library and the sentil CLI"
arch=('x86_64')
url="https://github.com/sedislab/SENTIL"
license=('MIT' 'Apache')
depends=('gcc-libs')
optdepends=('cmake: find_package(Sentil) support for C and C++ projects'
            'pkgconf: pkg-config discovery of the C library')
provides=('libsentil.so')
options=('!strip' '!debug')
_cabi="sentil-${pkgver}-linux-x86_64"
_cli="sentil-${pkgver}-x86_64-unknown-linux-gnu"
source=("${_cabi}.tar.gz::${url}/releases/download/v${pkgver}/${_cabi}.tar.gz"
        "${_cli}.tar.gz::${url}/releases/download/v${pkgver}/${_cli}.tar.gz")
sha256sums=('REPLACE_WITH_X86_64_LINUX_CABI_SHA256'
            'REPLACE_WITH_X86_64_LINUX_CLI_SHA256')

package() {
  cd "${srcdir}"

  # The C library, header, and the pkg-config and CMake discovery files. The
  # bundled sentil.pc points at /usr/local from the build host, so retarget it to
  # the package prefix here.
  install -Dm755 "${_cabi}/lib/libsentil.so" "${pkgdir}/usr/lib/libsentil.so"
  install -Dm644 "${_cabi}/lib/libsentil.a" "${pkgdir}/usr/lib/libsentil.a"
  install -Dm644 "${_cabi}/include/sentil.h" "${pkgdir}/usr/include/sentil.h"

  sed 's|^prefix=.*|prefix=/usr|' "${_cabi}/lib/pkgconfig/sentil.pc" > sentil.pc
  install -Dm644 sentil.pc "${pkgdir}/usr/lib/pkgconfig/sentil.pc"

  install -Dm644 "${_cabi}/lib/cmake/Sentil/SentilConfig.cmake" \
    "${pkgdir}/usr/lib/cmake/Sentil/SentilConfig.cmake"

  install -Dm755 "${_cli}/bin/sentil" "${pkgdir}/usr/bin/sentil"
  if [ -f "${_cli}/man/sentil.1" ]; then
    install -Dm644 "${_cli}/man/sentil.1" "${pkgdir}/usr/share/man/man1/sentil.1"
  fi
  if [ -f "${_cli}/completions/sentil.bash" ]; then
    install -Dm644 "${_cli}/completions/sentil.bash" \
      "${pkgdir}/usr/share/bash-completion/completions/sentil"
  fi
  if [ -f "${_cli}/completions/_sentil" ]; then
    install -Dm644 "${_cli}/completions/_sentil" \
      "${pkgdir}/usr/share/zsh/site-functions/_sentil"
  fi
  if [ -f "${_cli}/completions/sentil.fish" ]; then
    install -Dm644 "${_cli}/completions/sentil.fish" \
      "${pkgdir}/usr/share/fish/vendor_completions.d/sentil.fish"
  fi

  # Dual license, as the AUR expects for a non-standard combination.
  install -Dm644 "${_cli}/LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 "${_cli}/LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}